# 複製成 .env 後修改：cp .env.example .env
# 排程與手動指令都會讀這個檔案（已經用 export 設定的變數優先）

# docker compose 的 PostgreSQL（根目錄 docker compose up -d --build 之後就能連）
DATABASE_URL=postgresql://ai:ai@localhost:5434/ai_interview

# 選填：有填才會用 AI 寫職缺摘要與重點（不轉貼原文）；可直接複製 backend/.env 的金鑰
OPENAI_API_KEY=
CRAWLER_SUMMARIZE=true
CRAWLER_SUMMARY_MODEL=gpt-5-mini

# 爬蟲身分與禮貌設定（請把網域與信箱改成你的）
CRAWLER_USER_AGENT=AIInterviewJobBot/0.1 (+https://your-domain/bot; contact: you@your-domain)
CRAWLER_DELAY_SEC=2
CRAWLER_MAX_PAGES_PER_SITE=60
CRAWLER_MAX_JOBS_PER_SITE=50

# 要爬的公司清單；空白 = ../job_crawlers/sources/companies.json
SOURCES_FILE=

# 排程（./run.sh start）：每天幾點執行，24 小時制，多個時間用逗號分隔；空白 = 不排程
CRAWL_AT=02:00
VERIFY_AT=04:00
VERIFY_LIMIT=300
# 啟動排程時先立刻爬一次
RUN_ON_START=false
