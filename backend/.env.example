# 複製成 .env 後修改。沒有 OPENAI_API_KEY 時使用本機假資料（開發模式），整個流程仍可走完。
ENV=dev
BASE_URL=http://localhost:8009
DATABASE_URL=postgresql://ai:ai@localhost:5434/ai_interview
REDIS_URL=redis://localhost:6381/0
S3_ENDPOINT=http://localhost:9100
S3_PUBLIC_ENDPOINT=http://localhost:9100
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ai-interview
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false

# Google 登入：Google Cloud Console → API 和服務 → 憑證 → 建立 OAuth 用戶端 ID（網頁應用程式）
# 已授權的重新導向 URI：http://localhost:8009/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 管理後台（網頁 /#admin）：三個條件都符合才能進
#   1. 登入帳號在 ADMIN_GOOGLE_EMAILS（逗號分隔）  2. 這次是用 Google 登入（同帳號用密碼登入也不行）  3. 輸入下面的後台帳密
# 任一項留白 → 後台整個關閉。密碼請用長一點的隨機字串（例如 openssl rand -base64 24）
ADMIN_GOOGLE_EMAILS=
ADMIN_CONSOLE_USERNAME=
ADMIN_CONSOLE_PASSWORD=
# ADMIN_CONSOLE_MINUTES=30   # 輸入後台密碼後可以用多久

OPENAI_API_KEY=
# 模型名稱請以 OpenAI 官方文件為準；TTS 聲音建議 marin（女聲）或 cedar（男聲），最自然
LLM_MODEL_REASONING=gpt-5
LLM_MODEL_FAST=gpt-5-mini
# 推理強度：minimal / low / medium / high（只對推理模型有效；空白＝模型預設，會比較慢）
LLM_EFFORT_REASONING=low
LLM_EFFORT_FAST=minimal
STT_MODEL_FAST=gpt-4o-mini-transcribe
STT_MODEL=gpt-4o-transcribe
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=marin
EMBEDDING_MODEL=text-embedding-3-small

# 履歷：每個帳號最多保留幾份（每份解析一次，出題、評分、職涯規劃共用）
RESUME_MAX_COUNT=3

# 職涯規劃讀取 GitHub 作品集：選填。沒填時每個 IP 每小時只能呼叫 GitHub API 60 次
# 建立方式：GitHub → Settings → Developer settings → Fine-grained tokens，權限只要 Public repositories (read-only)
GITHUB_TOKEN=
PORTFOLIO_MAX_REPOS=5
PORTFOLIO_REPO_CHARS=120000

# 功能開關：職缺搜尋頁（正式環境第一版先關閉；改成 true 並重啟 api 即可打開）
FEATURE_JOB_SEARCH=false
