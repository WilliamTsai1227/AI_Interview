# 複製成 .env 後修改。沒有 OPENAI_API_KEY 時使用本機假資料（開發模式），整個流程仍可走完。
ENV=dev
BASE_URL=http://localhost:8009
DATABASE_URL=postgresql://ai:ai@localhost:5434/ai_interview
REDIS_URL=redis://localhost:6381/0
S3_ENDPOINT=http://localhost:9100
S3_PUBLIC_ENDPOINT=http://localhost:9100
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ai-interview
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false

# Google 登入：Google Cloud Console → API 和服務 → 憑證 → 建立 OAuth 用戶端 ID（網頁應用程式）
# 已授權的重新導向 URI：http://localhost:8009/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

OPENAI_API_KEY=
# 模型名稱請以 OpenAI 官方文件為準；TTS 聲音建議 marin（女聲）或 cedar（男聲），最自然
LLM_MODEL_REASONING=gpt-5
LLM_MODEL_FAST=gpt-5-mini
# 推理強度：minimal / low / medium / high（只對推理模型有效；空白＝模型預設，會比較慢）
LLM_EFFORT_REASONING=low
LLM_EFFORT_FAST=minimal
# 網路搜尋（職涯規劃找職缺）：較強的模型＋較高推理強度（minimal 不支援網路搜尋）
LLM_MODEL_SEARCH=gpt-5.5
LLM_EFFORT_SEARCH=medium
STT_MODEL_FAST=gpt-4o-mini-transcribe
STT_MODEL=gpt-4o-transcribe
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=marin
EMBEDDING_MODEL=text-embedding-3-small
