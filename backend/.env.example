# 複製成 .env 後修改。沒有 OPENAI_API_KEY 時使用本機假資料（開發模式），整個流程仍可走完。
ENV=dev
BASE_URL=http://localhost:8009
DATABASE_URL=postgresql://ai:ai@localhost:5434/ai_interview
REDIS_URL=redis://localhost:6381/0
S3_ENDPOINT=http://localhost:9100
S3_PUBLIC_ENDPOINT=http://localhost:9100
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ai-interview
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false

# Google 登入：Google Cloud Console → API 和服務 → 憑證 → 建立 OAuth 用戶端 ID（網頁應用程式）
# 已授權的重新導向 URI：http://localhost:8009/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 管理後台（網頁 /#admin）：三個條件都符合才能進
#   1. 登入帳號在 ADMIN_GOOGLE_EMAILS（逗號分隔）  2. 這次是用 Google 登入（同帳號用密碼登入也不行）  3. 輸入下面的後台帳密
# 任一項留白 → 後台整個關閉。密碼請用長一點的隨機字串（例如 openssl rand -base64 24）
ADMIN_GOOGLE_EMAILS=
ADMIN_CONSOLE_USERNAME=
ADMIN_CONSOLE_PASSWORD=
# ADMIN_CONSOLE_MINUTES=30   # 輸入後台密碼後可以用多久

# MCP 連接器（設定 → MCP 連接器，使用者授權自己的 Notion）：token 加密金鑰，32 bytes 的 base64
# 產生方式：openssl rand -base64 32。開發環境留白會由 JWT_SECRET 推導；正式環境留白 → 連接器整個關閉
# 上線後不要更換，換了之前存的授權會解不開（使用者要重新連接）
MCP_CONNECTOR_ENC_KEY=
# NOTION_MCP_URL=https://mcp.notion.com/mcp

OPENAI_API_KEY=
# 模型名稱請以 OpenAI 官方文件為準（gpt-5 系列 2026-12-11 停用）。sol＝日常主力（出題、評分），terra＝快速（追問，要 3 秒內）
LLM_MODEL_REASONING=gpt-6.2-sol
LLM_MODEL_FAST=gpt-6.1-terra
# 推理強度（空白＝模型預設，會比較慢）：gpt-6.2-sol 可用 low/medium/high/xhigh/max；gpt-6.1-terra 另外可用 none
LLM_EFFORT_REASONING=low
LLM_EFFORT_FAST=none
STT_MODEL_FAST=gpt-transcribe
STT_MODEL=gpt-transcribe
# TTS_MODEL 填 gpt-realtime-*：用 Realtime 語音模型念稿，比 gpt-4o-mini-tts（2027-01-06 停用）自然；聲音建議 marin（女聲）或 cedar（男聲）
TTS_MODEL=gpt-realtime-2.1-mini
TTS_VOICE=marin
EMBEDDING_MODEL=text-embedding-3-small
# Live 即時對談（GPT-Live，依秒計費）。LIVE_DELEGATE_MODEL：Ava 靠它呼叫「結束面試」等工具；空白＝不委派
LIVE_MODEL=gpt-live-1.1
LIVE_VOICE=
LIVE_DELEGATE_MODEL=gpt-6.1-terra

# 面試官擬真人像（Simli，依分鐘計費）：https://www.simli.com 註冊後在後台取得 API key；空白＝用瀏覽器內的插畫人像
# SIMLI_FACE_ID：後台挑的臉（預設 Anna）。改完要重啟 api（CSP 會放行 wss://api.simli.ai）
SIMLI_API_KEY=
SIMLI_FACE_ID=14c60d62-6ebf-424d-b626-1f4f91c33b04

# 履歷：每個帳號最多保留幾份（每份解析一次，出題、評分、職涯規劃共用）
RESUME_MAX_COUNT=3

# 職涯規劃讀取 GitHub 作品集：選填。沒填時每個 IP 每小時只能呼叫 GitHub API 60 次
# 建立方式：GitHub → Settings → Developer settings → Fine-grained tokens，權限只要 Public repositories (read-only)
GITHUB_TOKEN=
PORTFOLIO_MAX_REPOS=5
PORTFOLIO_REPO_CHARS=120000

# 功能開關：職缺搜尋頁（正式環境第一版先關閉；改成 true 並重啟 api 即可打開）
FEATURE_JOB_SEARCH=false
